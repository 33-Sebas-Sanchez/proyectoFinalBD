# ============================================================================
# Conexiones a las 6 bases de datos de Neon.
#
# 1. Copia este archivo como .env
# 2. Completa cada cadena con los datos de tu base en Neon
# 3. .env está en .gitignore: nunca lo subas al repositorio
#
# Neon entrega algo como:
#   postgresql://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# Para Spring Boot se necesita el formato JDBC, sin usuario ni clave dentro:
#   jdbc:postgresql://ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# Si la cadena de Neon incluye &channel_binding=require, quítalo: el driver
# JDBC no lo necesita y puede rechazarlo.
# ============================================================================

# ---------------------------- Catálogo y terceros ---------------------------
CATALOGO_DB_URL=jdbc:postgresql://<host>/<base>?sslmode=require
CATALOGO_DB_USER=<usuario>
CATALOGO_DB_PASSWORD=<clave>

# ---------------------------- Compras y abastecimiento ----------------------
COMPRAS_DB_URL=jdbc:postgresql://<host>/<base>?sslmode=require
COMPRAS_DB_USER=<usuario>
COMPRAS_DB_PASSWORD=<clave>

# ---------------------------- Inventarios y transferencias ------------------
INVENTARIOS_DB_URL=jdbc:postgresql://<host>/<base>?sslmode=require
INVENTARIOS_DB_USER=<usuario>
INVENTARIOS_DB_PASSWORD=<clave>

# ---------------------------- Ventas y pagos --------------------------------
VENTAS_DB_URL=jdbc:postgresql://<host>/<base>?sslmode=require
VENTAS_DB_USER=<usuario>
VENTAS_DB_PASSWORD=<clave>

# ---------------------------- Identidad y accesos ---------------------------
IDENTIDAD_DB_URL=jdbc:postgresql://<host>/<base>?sslmode=require
IDENTIDAD_DB_USER=<usuario>
IDENTIDAD_DB_PASSWORD=<clave>

# ---------------------------- Reportes corporativos -------------------------
REPORTES_DB_URL=jdbc:postgresql://<host>/<base>?sslmode=require
REPORTES_DB_USER=<usuario>
REPORTES_DB_PASSWORD=<clave>

# ---------------------------- URLs entre servicios --------------------------
# Solo se usan al ejecutar reportes-service en local.
# En Render se generan automáticamente desde render.yaml.
CATALOGO_URL=http://localhost:8081
COMPRAS_URL=http://localhost:8082
INVENTARIOS_URL=http://localhost:8083
VENTAS_URL=http://localhost:8084
IDENTIDAD_URL=http://localhost:8085
