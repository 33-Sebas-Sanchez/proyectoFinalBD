% ============================================================================
% estilo-proyecto.sty
% Estilo sobrio para los documentos del Proyecto Final de Bases de Datos.
% Tipografia: STIX Two Text (texto), Source Sans 3 (sans), JetBrains Mono (mono)
% Requiere compilar con XeLaTeX o LuaLaTeX.
% ============================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{estilo-proyecto}[2026/11/09 Estilo discreto Proyecto Final BD]

% ---------------------------------------------------------------- geometria
\RequirePackage[
  letterpaper,
  left=2.3cm, right=2.3cm,
  top=2.4cm, bottom=2.4cm,
  headsep=0.55cm, footskip=1.0cm
]{geometry}

% ---------------------------------------------------------------- tipografia
\RequirePackage{fontspec}
\RequirePackage{unicode-math}

\setmainfont{STIX Two Text}
\setsansfont{Source Sans 3}[Scale=MatchLowercase]
\setmonofont{JetBrains Mono}[Scale=MatchLowercase]
\setmathfont{STIX Two Math}

\RequirePackage[spanish,es-noshorthands]{babel}
\RequirePackage{microtype}

% ---------------------------------------------------------------- color
\RequirePackage[table]{xcolor}

\definecolor{acento}{HTML}{243B53}      % azul tinta, titulos y acentos
\definecolor{acento2}{HTML}{486581}     % azul medio, numeracion y detalles
\definecolor{gris}{HTML}{616E7C}        % texto secundario
\definecolor{grisClaro}{HTML}{9AA5B1}   % notas y pies
\definecolor{linea}{HTML}{D3DCE6}       % reglas finas
\definecolor{fondo}{HTML}{F4F6F8}       % relleno muy suave
\definecolor{pk}{HTML}{8A3B2A}          % clave primaria
\definecolor{fk}{HTML}{2B5C8A}          % clave foranea
\definecolor{ok}{HTML}{2F6B4F}          % permisos plenos

% ---------------------------------------------------------------- tablas
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{longtable}
\RequirePackage{needspace}

\renewcommand{\arraystretch}{1.18}

% ---------------------------------------------------------------- listas
\RequirePackage{enumitem}

% ---------------------------------------------------------------- secciones
\RequirePackage{titlesec}

\titleformat{\section}[hang]
  {\sffamily\large\bfseries}
  {\textcolor{acento2}{\thesection}\hspace{0.55em}}
  {0pt}
  {\color{acento}}
  [\vspace{-0.35em}{\color{linea}\rule{\linewidth}{0.5pt}}]

\titleformat{\subsection}[hang]
  {\sffamily\bfseries\normalsize}
  {\textcolor{acento2}{\thesubsection}\hspace{0.5em}}
  {0pt}
  {\color{acento!90!black}}

\titlespacing*{\section}{0pt}{1.7em}{0.9em}
\titlespacing*{\subsection}{0pt}{1.2em}{0.5em}

% ---------------------------------------------------------------- cabecera
\RequirePackage{fancyhdr}

\newcommand{\docnombre}[1]{\def\elnombredoc{#1}}
\docnombre{}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\headrule}{\hbox to\headwidth{%
  \color{linea}\leaders\hrule height \headrulewidth\hfill}}
\fancyhead[L]{\footnotesize\sffamily\color{gris}%
  Universidad Distrital Francisco Jos\'e de Caldas \textperiodcentered{}
  Ingenier\'ia de Sistemas}
\fancyhead[R]{\footnotesize\sffamily\color{gris}\elnombredoc}
\fancyfoot[C]{\footnotesize\sffamily\color{gris}\thepage}
\setlength{\headheight}{15pt}

% ---------------------------------------------------------------- parrafos
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.45em}

% ---------------------------------------------------------------- hyperref
\RequirePackage[hidelinks]{hyperref}
\hypersetup{
  pdfauthor={Sergio Leonardo Moreno Granado; Sebasti\'an S\'anchez},
  pdfsubject={Proyecto Final de Bases de Datos}
}

% ============================================================================
% COMANDOS DEL PROYECTO
% ============================================================================

% Encabezado editorial del documento
% \portadilla{etiqueta}{titulo}{subtitulo}
\newcommand{\portadilla}[3]{%
  \thispagestyle{empty}%
  \begin{flushleft}
    {\sffamily\footnotesize\bfseries\color{acento2}%
      \MakeUppercase{#1}\par}
    \vspace{0.7em}
    {\fontsize{24}{29}\selectfont\bfseries\color{acento}#2\par}
    \vspace{0.35em}
    {\large\color{gris}#3\par}
    \vspace{1.0em}
    {\sffamily\small\color{gris}%
      Sergio Leonardo Moreno Granado \textperiodcentered{}
      Sebasti\'an S\'anchez \textperiodcentered{} Noviembre 2026\par}
    \vspace{0.5em}
    {\color{linea}\rule{\linewidth}{0.5pt}}
  \end{flushleft}%
  \vspace{0.4em}%
}

% Encabezado de esquema (nivel de seccion)
% \esquema{nombre}{descripcion}
\newcommand{\esquema}[2]{%
  \section[Esquema #1]{Esquema \texttt{#1}}%
  {\sffamily\small\color{gris}#2\par}%
  \vspace{0.2em}%
}

% Encabezado de tabla del diccionario
% Entorno de tabla del diccionario (mantiene el titulo junto a la tabla)
% \begin{tabladic}{nombre} ... \end{tabladic}
\newenvironment{tabladic}[1]{%
  \par\addvspace{1.15em}%
  \noindent
  \begin{minipage}{\linewidth}%
  {\sffamily\small\bfseries\color{acento}Tabla}\enspace
  {\ttfamily\small\color{acento!85!black}#1}\par
  \vspace{0.12em}%
  {\color{linea}\rule{\linewidth}{0.4pt}}\par
  \vspace{-0.25em}%
}{%
  \end{minipage}%
  \par\addvspace{0.2em}%
}

% Marcadores de clave
\newcommand{\pk}[1]{%
  \textcolor{pk}{\textbf{#1}}%
  \hspace{0.32em}{\scriptsize\sffamily\textcolor{pk}{PK}}}
\newcommand{\fk}[1]{%
  \textcolor{fk}{#1}%
  \hspace{0.32em}{\scriptsize\sffamily\textcolor{fk}{FK}}}
\newcommand{\uq}[1]{%
  #1\hspace{0.25em}{\scriptsize\sffamily\textcolor{gris}{UQ}}}

% Nota al pie de una tabla
\newcommand{\nota}[1]{%
  \par\vspace{0.22em}%
  {\footnotesize\sffamily\color{gris}\raggedright#1\par}}

% Tipos de columna para el diccionario
\newcolumntype{A}{>{\ttfamily\small\raggedright\arraybackslash}p{3.95cm}}
\newcolumntype{T}{>{\ttfamily\small\color{gris}\raggedright\arraybackslash}p{2.9cm}}
\newcolumntype{R}{>{\small\raggedright\arraybackslash}X}

% Cabecera de tabla de diccionario
\newcommand{\cabecera}{%
  \rowcolor{fondo}%
  {\sffamily\bfseries\footnotesize Atributo} &
  {\sffamily\bfseries\footnotesize Tipo de dato} &
  {\sffamily\bfseries\footnotesize Restricciones y notas}\\
  \midrule
}

\endinput
