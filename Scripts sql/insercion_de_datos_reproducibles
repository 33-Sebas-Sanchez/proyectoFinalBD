-- ventas_pagos
-- ###########################################################################

-- ---------------------- Pedidos de venta: 350 ------------------------------
-- total_registrado se inicializa en 0 y se calcula luego con UPDATE.
-- Estados variados. id_almacen debe ser coherente con id_sede, pero el
-- diccionario no obliga esa relación, así que usamos almacenes de la misma sede
-- de forma determinística.
INSERT INTO ventas_pagos.pedidos_venta
    (id_pedido, id_sede, id_almacen, id_cliente, id_empleado, fecha_pedido, estado, total_registrado)
SELECT
    g,
    sede,
    alm,
    ((g - 1) % 120) + 1,
    ((g - 1) % 25) + 1,
    DATE '2026-02-01' + (g % 60),
    (ARRAY['Pendiente','Completado','Cancelado'])[((g - 1) % 3) + 1],
    0
FROM (
    SELECT g,
           ((g - 1) % 5) + 1 AS sede,
           -- almacén determinístico dentro del rango 1..8
           ((g * 2 - 1) % 8) + 1 AS alm
    FROM generate_series(1, 350) AS g
) s;

-- ---------------------- Detalle pedido (PK compuesta) ----------------------
-- 1 a 4 líneas por pedido (número determinístico). cantidad > 0 ;
-- precio_unitario = precio_lista del producto (>= 0).
-- Se generan líneas candidatas y luego DISTINCT ON (id_pedido, id_producto)
-- descarta cualquier colisión de producto dentro del mismo pedido (lo que
-- violaría la PK compuesta). Esto funciona porque el deduplicado ocurre ANTES
-- del INSERT, a diferencia de un NOT EXISTS contra la tabla destino.
INSERT INTO ventas_pagos.detalle_pedido
    (id_pedido, id_producto, cantidad, precio_unitario)
SELECT DISTINCT ON (cand.id_pedido, cand.id_producto)
    cand.id_pedido,
    cand.id_producto,
    1 + ((cand.id_pedido + cand.linea) % 9),      -- 1..9, siempre > 0
    p.precio_lista
FROM (
    SELECT
        pv.id_pedido,
        linea,
        (((pv.id_pedido * 3 + linea * 31) % 100) + 1) AS id_producto
    FROM ventas_pagos.pedidos_venta pv
    CROSS JOIN LATERAL generate_series(0, (pv.id_pedido % 4)) AS linea   -- 1..4 líneas
) cand
JOIN catalogo_terceros.productos p ON p.id_producto = cand.id_producto
ORDER BY cand.id_pedido, cand.id_producto, cand.linea;

-- ---------------------- Cálculo de total_registrado (UPDATE) ---------------
-- total = SUM(cantidad * precio_unitario). Pedidos 'Cancelado' se dejan en 0.
UPDATE ventas_pagos.pedidos_venta pv
SET total_registrado = COALESCE(d.total, 0)
FROM (
    SELECT id_pedido, SUM(cantidad * precio_unitario) AS total
    FROM ventas_pagos.detalle_pedido
    GROUP BY id_pedido
) d
WHERE d.id_pedido = pv.id_pedido
  AND pv.estado <> 'Cancelado';

-- ---------------------- Pagos --------------------------------------------
-- Un pago por cada pedido 'Completado' (valor = total, > 0). Medio y estado variados.
INSERT INTO ventas_pagos.pagos
    (id_pago, id_pedido, fecha_pago, valor, medio_pago, estado)
SELECT
    row_number() OVER (ORDER BY pv.id_pedido),
    pv.id_pedido,
    pv.fecha_pedido + 1,
    pv.total_registrado,
    (ARRAY['Efectivo','Tarjeta Debito','Tarjeta Credito','Transferencia'])[((pv.id_pedido - 1) % 4) + 1],
    'Confirmado'
FROM ventas_pagos.pedidos_venta pv
WHERE pv.estado = 'Completado'
  AND pv.total_registrado > 0;

-- ---------------------- Devoluciones: 25 -----------------------------------
-- Se asocian a pedidos 'Completado' (reales, con detalle). Estados variados.
-- IMPORTANTE: el estado/motivo se derivan de rn (número correlativo 1..25),
-- NO de id_pedido. Los pedidos 'Completado' cumplen id_pedido ≡ 2 (mod 3), así
-- que (id_pedido-1) % 3 daría SIEMPRE el mismo valor -> todas 'Aprobada'.
-- Usando rn garantizamos que los 3 estados aparezcan de forma rotada.
INSERT INTO ventas_pagos.devoluciones
    (id_devolucion, id_pedido, fecha_solicitud, motivo, estado)
SELECT
    c.rn,
    c.id_pedido,
    c.fecha_pedido + 5,
    (ARRAY['Producto defectuoso','Cliente insatisfecho','Error en el pedido','Producto dañado en transporte'])[((c.rn - 1) % 4) + 1],
    (ARRAY['Solicitada','Aprobada','Rechazada'])[((c.rn - 1) % 3) + 1]
FROM (
    SELECT
        row_number() OVER (ORDER BY pv.id_pedido) AS rn,
        pv.id_pedido,
        pv.fecha_pedido
    FROM ventas_pagos.pedidos_venta pv
    WHERE pv.estado = 'Completado'
    ORDER BY pv.id_pedido
    LIMIT 25
) c;

-- ---------------------- Detalle devolución (PK compuesta) ------------------
-- Devuelve 1 línea por devolución: toma un producto realmente comprado en ese pedido.
INSERT INTO ventas_pagos.detalle_devolucion
    (id_devolucion, id_producto, cantidad, condicion_producto)
SELECT
    dev.id_devolucion,
    dp.id_producto,
    1,   -- cantidad > 0 (se devuelve 1 unidad; <= lo comprado)
    (ARRAY['Buen Estado','Defectuoso','Dañado'])[((dev.id_devolucion - 1) % 3) + 1]
FROM ventas_pagos.devoluciones dev
CROSS JOIN LATERAL (
    SELECT id_producto
    FROM ventas_pagos.detalle_pedido dp2
    WHERE dp2.id_pedido = dev.id_pedido
    ORDER BY dp2.id_producto
    LIMIT 1
) dp;
