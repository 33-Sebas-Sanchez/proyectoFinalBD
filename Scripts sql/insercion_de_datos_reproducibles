-- ---------------------- Órdenes de compra: 75 ------------------------------
-- fecha_estimada = fecha_orden + (3..12 días) -> cumple fecha_estimada >= fecha_orden.
-- id_empleado restringido a empleados con rol de compras-ish (usamos 1..25).
INSERT INTO compras_abastecimiento.ordenes_compra
    (id_orden_compra, id_proveedor, id_almacen_destino, id_empleado, fecha_orden, fecha_estimada, estado)
SELECT
    g,
    ((g - 1) % 12) + 1,
    ((g - 1) % 8) + 1,
    ((g - 1) % 25) + 1,
    DATE '2026-01-05' + (g % 40),
    DATE '2026-01-05' + (g % 40) + (3 + (g % 10)),
    (ARRAY['Pendiente','Recibida Parcial','Recibida Total','Cancelada'])[((g - 1) % 4) + 1]
FROM generate_series(1, 75) AS g;

-- ---------------------- Detalle orden de compra (PK compuesta) -------------
-- 2 líneas por orden: productos (g y g+37 mod 100). DISTINCT ON evita que, si
-- ambos productos coincidieran, se viole la PK compuesta (id_orden_compra, id_producto).
INSERT INTO compras_abastecimiento.detalle_orden_compra
    (id_orden_compra, id_producto, cantidad_solicitada, costo_unitario)
SELECT DISTINCT ON (cand.id_orden_compra, cand.id_producto)
    cand.id_orden_compra,
    cand.id_producto,
    10 + ((cand.id_orden_compra * 7 + cand.id_producto) % 190),   -- 10..199, siempre > 0
    round(p.precio_lista * 0.7, 2)
FROM (
    SELECT oc.id_orden_compra, prod.id_producto
    FROM compras_abastecimiento.ordenes_compra oc
    CROSS JOIN LATERAL (
        VALUES
            (((oc.id_orden_compra - 1) % 100) + 1),
            (((oc.id_orden_compra + 36) % 100) + 1)
    ) AS prod(id_producto)
) cand
JOIN catalogo_terceros.productos p ON p.id_producto = cand.id_producto
ORDER BY cand.id_orden_compra, cand.id_producto;

-- ---------------------- Recepciones de compra ------------------------------
-- Una recepción por cada orden que NO esté 'Cancelada' ni 'Pendiente'
-- (es decir, 'Recibida Parcial' -> 'Parcial' y 'Recibida Total' -> 'Procesado').
INSERT INTO compras_abastecimiento.recepciones_compra
    (id_recepcion, id_orden_compra, fecha_recepcion, estado)
SELECT
    row_number() OVER (ORDER BY oc.id_orden_compra),
    oc.id_orden_compra,
    oc.fecha_estimada,
    CASE oc.estado
        WHEN 'Recibida Total'   THEN 'Procesado'
        WHEN 'Recibida Parcial' THEN 'Parcial'
    END
FROM compras_abastecimiento.ordenes_compra oc
WHERE oc.estado IN ('Recibida Total', 'Recibida Parcial');

-- ---------------------- Detalle recepción (PK compuesta) -------------------
-- Para cada recepción, se reciben los mismos productos de la orden.
-- 'Procesado' -> se recibe todo lo solicitado ; 'Parcial' -> se recibe ~mitad.
INSERT INTO compras_abastecimiento.detalle_recepcion
    (id_recepcion, id_producto, cantidad_recibida)
SELECT
    r.id_recepcion,
    d.id_producto,
    CASE r.estado
        WHEN 'Procesado' THEN d.cantidad_solicitada
        ELSE (d.cantidad_solicitada / 2)
    END
FROM compras_abastecimiento.recepciones_compra r
JOIN compras_abastecimiento.detalle_orden_compra d
     ON d.id_orden_compra = r.id_orden_compra;

