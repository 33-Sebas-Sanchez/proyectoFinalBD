-- ---------------------- Inventarios ----------------------------------------
-- Existencia por (almacen, producto) para un subconjunto: cada almacén lleva
-- 15 productos (distribución determinística). PK compuesta (id_almacen, id_producto).
INSERT INTO inventarios_transferencias.inventarios
    (id_sede, id_almacen, id_producto, existencia_actual, stock_minimo, fecha_actualizacion)
SELECT
    a.id_sede,
    a.id_almacen,
    prod.id_producto,
    50 + ((a.id_almacen * 13 + prod.id_producto) % 450),   -- 50..499
    10 + (prod.id_producto % 30),                          -- 10..39
    DATE '2026-03-01' + (prod.id_producto % 20)
FROM catalogo_terceros.almacenes a
CROSS JOIN LATERAL (
    SELECT (((a.id_almacen - 1) * 15 + s) % 100) + 1 AS id_producto
    FROM generate_series(0, 14) AS s
) AS prod;

-- ---------------------- Transferencias: 30 ---------------------------------
-- origen <> destino (se fuerza con un desfase). Fechas coherentes:
--   despacho = solicitud + 1..3 ; recepcion = despacho + 1..3.
-- Estados variados: para 'Solicitada' no hay despacho ni recepción;
-- para 'Despachada' hay despacho pero no recepción; 'Recibida' tiene ambas;
-- 'Cancelada' sin fechas posteriores. (Respeta ck_transferencias_fechas, que
--  solo compara cuando las fechas no son NULL.)
INSERT INTO inventarios_transferencias.transferencias
    (id_transferencia, id_almacen_origen, id_almacen_destino, fecha_solicitud, fecha_despacho, fecha_recepcion, estado)
SELECT
    g,
    ((g - 1) % 8) + 1                                   AS origen,
    (((g - 1) % 8 + 1 + (g % 7)) % 8) + 1               AS destino_tmp,  -- se corrige abajo
    DATE '2026-03-01' + (g % 25)                        AS f_sol,
    CASE WHEN st IN ('Despachada','Recibida') THEN DATE '2026-03-01' + (g % 25) + (1 + g % 3) END,
    CASE WHEN st = 'Recibida' THEN DATE '2026-03-01' + (g % 25) + (1 + g % 3) + (1 + g % 3) END,
    st
FROM (
    SELECT g,
           (ARRAY['Solicitada','Despachada','Recibida','Cancelada'])[((g - 1) % 4) + 1] AS st
    FROM generate_series(1, 30) AS g
) s;

-- Corrige cualquier caso donde origen = destino (garantiza origen <> destino).
UPDATE inventarios_transferencias.transferencias
SET id_almacen_destino = (id_almacen_destino % 8) + 1
WHERE id_almacen_origen = id_almacen_destino;
-- Segunda pasada por si el +1 volvió a coincidir.
UPDATE inventarios_transferencias.transferencias
SET id_almacen_destino = (id_almacen_destino % 8) + 1
WHERE id_almacen_origen = id_almacen_destino;

-- ---------------------- Detalle transferencia (PK compuesta) ---------------
-- 2 productos por transferencia. cantidad_enviada > 0.
-- cantidad_recibida: igual a enviada si 'Recibida', NULL en otros estados.
-- DISTINCT ON protege la PK compuesta (id_transferencia, id_producto).
INSERT INTO inventarios_transferencias.detalle_transferencia
    (id_transferencia, id_producto, cantidad_enviada, cantidad_recibida)
SELECT DISTINCT ON (cand.id_transferencia, cand.id_producto)
    cand.id_transferencia,
    cand.id_producto,
    cand.cant,
    CASE WHEN cand.estado = 'Recibida' THEN cand.cant ELSE NULL END
FROM (
    SELECT
        t.id_transferencia,
        prod.id_producto,
        t.estado,
        5 + ((t.id_transferencia * 3 + prod.id_producto) % 95) AS cant   -- 5..99
    FROM inventarios_transferencias.transferencias t
    CROSS JOIN LATERAL (
        VALUES
            (((t.id_transferencia - 1) % 100) + 1),
            (((t.id_transferencia + 49) % 100) + 1)
    ) AS prod(id_producto)
) cand
ORDER BY cand.id_transferencia, cand.id_producto;

