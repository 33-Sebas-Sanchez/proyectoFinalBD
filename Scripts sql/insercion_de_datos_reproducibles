-- ============================================================================
-- Proyecto Final - Bases de Datos
-- Datos de prueba reproducibles (GENERACIÓN MASIVA)
-- ----------------------------------------------------------------------------
-- Estrategia:
--   * Determinístico: se fija la semilla con setseed(0.42). Cada ejecución
--     produce EXACTAMENTE el mismo conjunto de datos.
--   * Volúmenes POR ENCIMA del mínimo solicitado (ver resumen al final del chat).
--   * Se generan filas con generate_series y se derivan atributos con funciones
--     determinísticas (md5, mod, etc.) para variar estados/categorías/fechas.
--   * total_registrado de los pedidos NO se escribe a mano: se calcula con un
--     UPDATE a partir de SUM(cantidad * precio_unitario) del detalle real.
--   * Todos los valores respetan los CHECK del diccionario (estados, fechas,
--     cantidades > 0, precios >= 0, origen <> destino, coherencia de fechas).
--   * Idempotente: el TRUNCATE inicial permite recargar sin duplicar.
--
-- VOLÚMENES GENERADOS:
--   Sedes: 5 (1 Distribución) | Almacenes: 8 | Categorías: 6 | Productos: 100
--   Proveedores: 12 | Clientes: 120 | Empleados: 25 | Usuarios: 25
--   Órdenes compra: 75 (+ detalles + recepciones) | Pedidos venta: 350 (+ detalles + pagos)
--   Transferencias: 30 | Devoluciones: 25 (todas con detalles)
-- ============================================================================

-- Semilla determinística: debe ir en la misma sesión que los INSERT que usan random().
SELECT setseed(0.42);

-- ---------------------------------------------------------------------------
-- Limpieza previa (orden inverso a las dependencias) para recarga idempotente
-- ---------------------------------------------------------------------------
TRUNCATE TABLE
    ventas_pagos.detalle_devolucion,
    ventas_pagos.devoluciones,
    ventas_pagos.pagos,
    ventas_pagos.detalle_pedido,
    ventas_pagos.pedidos_venta,
    inventarios_transferencias.detalle_transferencia,
    inventarios_transferencias.transferencias,
    inventarios_transferencias.inventarios,
    compras_abastecimiento.detalle_recepcion,
    compras_abastecimiento.recepciones_compra,
    compras_abastecimiento.detalle_orden_compra,
    compras_abastecimiento.ordenes_compra,
    identidad_accesos.auditoria_accesos,
    identidad_accesos.usuarios,
    identidad_accesos.empleados,
    catalogo_terceros.producto_proveedor,
    catalogo_terceros.clientes,
    catalogo_terceros.proveedores,
    catalogo_terceros.productos,
    catalogo_terceros.categorias,
    catalogo_terceros.almacenes,
    catalogo_terceros.sedes
    RESTART IDENTITY;

